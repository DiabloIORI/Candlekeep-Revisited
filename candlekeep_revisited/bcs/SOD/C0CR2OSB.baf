// BAELOTH
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyBaeloth1","MYAREA",0)
	Switch("C02OspreyBaeloth1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Baeloth",~别吵了，吟游诗人！你扰得我没法专心思考。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyBaeloth1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~贝洛斯，我得每日向迪奈尔主祈祷。再说我们离得够远，应该没怎么打扰到你吧。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyBaeloth1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Baeloth",~我的听力可比你这种半精灵地表生物敏锐得多。你低声嘀咕的每一个字我都听得见。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyBaeloth1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~是吗？那还真方便。我都要嫉妒了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyBaeloth1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Baeloth",~你本该嫉妒。哼，想达到我这般修为，可是难于登天。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyBaeloth1","MYAREA",50)
END
// CORWIN
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyCorwin1","MYAREA",0)
	Switch("C02OspreyCorwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Corwin",~奥斯普蕾，你靴带松了。就这么晃着，早晚得绊倒。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyCorwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~哦，你说得对……呃，我是说，多谢提醒，队长！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyCorwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Corwin",~不用这么拘谨。你虽然加入了炎骑士团，但在这儿我们不分上下级。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyCorwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~抱歉。只是……我很敬重烛堡的守望者。我很想念他们，所以见到长官就，呃……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyCorwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Corwin",~没事，我懂。有时候我在家也分不清我父亲和军官的身份。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyCorwin1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Corwin",~但我们不是在总部操练，也不是在巡城。在这儿，我们就是战友，互相照应。要做到这点，就得平等相待。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
RESPONSE #60
	DisplayStringHead("C0CR2OS",~明白了，队——我是说，科温。我也会照应你的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyCorwin1","MYAREA",-1)
END
// DORN
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyDorn1","MYAREA",0)
	Switch("C02OspreyDorn1","MYAREA")
THEN
