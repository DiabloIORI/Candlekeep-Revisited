	DisplayStringHead("Dorn",~你哼个没完，烦死人了。闭嘴，不然我让你永远闭嘴。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDorn1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~多恩，你就不能消停会儿吗？我觉得有节奏能帮我集中精神。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDorn1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dorn",~不能。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDorn1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~*叹气*我算是看透你了。我总试着看别人的优点，但有时候真的很难。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDorn1","MYAREA",-1)
END
// DYNAHEIR
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyDynaheir1","MYAREA",0)
	Switch("C02OspreyDynaheir1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dynaheir",~听说你是卡德利的弟子。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDynaheir1","MYAREA",2)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~是的。不过我拜师的时间还不长。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDynaheir1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dynaheir",~他与烛堡的大学士们都愿意收你为徒，足见你资质非凡。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDynaheir1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~哦，我倒不确定。朋友们以前总说我不过是受老师偏爱罢了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDynaheir1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dynaheir",~向博学之人求教，乃是智慧之始。若你认为我配得上，我也乐意相助。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDynaheir1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0CR2OS",~真的吗？能向您请教，我求之不得。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyDynaheir1","MYAREA",-1)
END
// EDWIN
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyEdwin1","MYAREA",0)
	Switch("C02OspreyEdwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Edwin",~离我远点，小抄写员。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyEdwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~艾德温！我没做什么得罪你的事吧？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyEdwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Edwin",~你装也没用，我看你走到哪儿，灾难就跟到哪儿。什么都逃不过我的眼睛。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyEdwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~是因为我把墨水瓶碰进火里炸了那件事对不对？我跟你说过了，我很抱歉！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyEdwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Edwin",~一句轻飘飘的道歉，赔不了那些卷轴，也赔不了我法袍上那些难看的污渍。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyEdwin1","MYAREA",-1)
END
// GLINT
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyGlint1","MYAREA",0)
	Switch("C02OspreyGlint1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Glint",~呃，奥斯普蕾，我无意冒犯，但你头发上那些树枝是怎么回事？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~什么？什么树枝？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Glint",~就是你头上、耳朵后面那些小树枝啊，说不定看不见的地方还有。你都快掉叶子了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~啊！这东西在头上多久了？别告诉我我一整天都顶着这东西走来走去！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Glint",~哦，原来不是时尚造型啊。我还在想是不是我也该弄点编胡子里。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0CR2OS",~不不不！就是个意外。我刚才看书的时候撞进灌木丛里了，就是这样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Glint",~哈。不过说真的，我倒觉得你没准误打误撞了。很多好点子都是意外来的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyGlint1","MYAREA",-1)
END
// JAHEIRA
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyJaheira1","MYAREA",0)
	Switch("C02OspreyJaheira1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Jaheira",~*叹气*奥斯普蕾，我赞赏你求学的热忱，但你也该多点常识。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyJaheira1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~我——您说什么，贾希拉？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyJaheira1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Jaheira",~要是再看见你在路上被石头、藤蔓绊倒，那么显眼，我都数不过来了。拜托，走路看着点！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyJaheira1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~呀！对、对不起！我以后一定注意，不让您失望！谢谢您提醒我！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyJaheira1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Jaheira",~你也不用对我这么低声下气。我不是你母亲。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyJaheira1","MYAREA",60)
RESPONSE #50
	DisplayStringHead("C0CR2OS",~对、对不起。老习惯了，改不了……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyJaheira1","MYAREA",-1)
END
// KHALID
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyKhalid1","MYAREA",0)
	Switch("C02OspreyKhalid1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Khalid",~你、你堂堂正正穿着迪奈尔信徒的服饰，奥斯普蕾。我认识几个熟人，肯定会很喜欢、喜欢你的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~我也肯定会喜欢他们的。就像我喜欢你一样，哈立德。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Khalid",~你太、太客气了。不过我觉得我没、没有那么多学识，配不上和你平起平坐。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~你这就是谦虚了。你很聪明，哈立德。而且比看上去有学问得多。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Khalid",~哦，我可不敢、敢夸这个口。只是不想让、让在乎的人失望罢了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",40)
RESPONSE #50
	DisplayStringHead("C0CR2OS",~努力和天赋一样重要。我觉得我们的共同点比你想的多，我的朋友。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",-1)
END
IF
	Global("C02OspreyKhalid2","MYAREA",2)
	Global("C02OspreyKhalid2_2","MYAREA",0)
	InParty("JAHEIRA")
THEN
	RESPONSE #100
		SetGlobal("C02OspreyKhalid2","MYAREA",3)
		SetGlobal("C02OspreyKhalid2_2","MYAREA",1)
END
IF
	Global("C02OspreyKhalid2","MYAREA",2)
	Global("C02OspreyKhalid2_2","MYAREA",0)
	!InParty("JAHEIRA")
THEN
	RESPONSE #100
		SetGlobal("C02OspreyKhalid2","MYAREA",10)
		SetGlobal("C02OspreyKhalid2_2","MYAREA",1)
END
IF
	Global("C02OspreyKhalid2","MYAREA",61)
	Global("C02OspreyKhalid2_61","MYAREA",0)
	InParty("JAHEIRA")
THEN
	RESPONSE #100
		SetGlobal("C02OspreyKhalid2","MYAREA",62)
		SetGlobal("C02OspreyKhalid2_61","MYAREA",1)
END
IF
	Global("C02OspreyKhalid2","MYAREA",61)
	Global("C02OspreyKhalid2_61","MYAREA",0)
	!InParty("JAHEIRA")
THEN
	RESPONSE #100
		SetGlobal("C02OspreyKhalid2","MYAREA",70)
		SetGlobal("C02OspreyKhalid2_61","MYAREA",1)
END
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyKhalid2","MYAREA",0)
	Switch("C02OspreyKhalid2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0CR2OS",~哈立德，谢谢你帮我补外衣。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",2)
RESPONSE #3
	DisplayStringHead("Jaheira",~又来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~……又来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Khalid",~没、没什么麻烦的，我保证。就是……这次尽量穿、穿久点，别再破了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~我尽量吧。你的针线活真好。我以前撕破的地方，几乎都看不出来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Khalid",~就是个实用的小、小手艺，这辈子学的。不过我挺惊讶，你第一反应居然是找、找我，不是贾希拉。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0CR2OS",~我怕贾希拉嫌我烦。她说不定会骂我，说我本来就不该老是闯祸。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Khalid",~她……嗯，说不定真会。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",61)
RESPONSE #62
	DisplayStringHead("Jaheira",~*清嗓子*~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Khalid",~不、不过……！她就是这么表达关、关心的。而且到最后她肯定还是会帮忙的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0CR2OS",~是啊，这我没法反驳！不过嘛，可能我还没长大，挨骂还是有点受不了。以前在图书馆里挨的骂够多了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyKhalid1","MYAREA",-1)
END
// M'KHIIN
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyMkhiin1","MYAREA",0)
	Switch("C02OspreyMkhiin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Mkhiin",~你带了好多书。看着挺沉。好像没什么用。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0CR2OS",~我是抄写员，姆金。记录事物是我的工作。不过你说得对，确实挺沉的……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Mkhiin",~我从没见过这么多书放一块儿。大多数哥布林都直接扔火里。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0CR2OS",~这……哦，我无意冒犯。但这话让我很生气。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Mkhiin",~跟我说话不用客气。哥布林本来就蠢。我知道。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0CR2OS",~但你……我觉得你不蠢，姆金。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Mkhiin",~我自己也不确定。懒得想那么多。不代表我不懂。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin1","MYAREA",-1)
END
IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02OspreyMkhiin2","MYAREA",0)
	Switch("C02OspreyMkhiin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0CR2OS",~姆金，你看得懂我们的文字吗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Mkhiin",~我会说。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02OspreyMkhiin2","MYAREA",20)
